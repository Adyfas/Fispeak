# Development-only overrides. Copy to `.env` if you need them.

# OpenRouter fallback for meeting summaries (Phase 4). Never required for core features.
OPENROUTER_API_KEY=

# Verbose logging in both processes.
FISPEAK_DEBUG=0

# Force a sidecar port instead of 8765 + fallback scan (Phase 2+).
FISPEAK_SIDECAR_PORT=

# Override the models directory (tests / dev).
FISPEAK_MODELS_DIR=
