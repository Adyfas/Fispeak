{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "preload/**/*.ts",
    "shared/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
